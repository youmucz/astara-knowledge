# Keep build context lean; multi-stage Dockerfile needs sources, not dist.
# `dist-embedded` is deliberately NOT ignored: the runtime stage copies that
# pre-built artifact (npm run build:embedded) to /usr/share/nginx/html/knowledge-assets.
