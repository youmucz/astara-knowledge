{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "implementation_version", "upstream_baseline", "upstream_commit", "feature_profile", "contracts", "images"],
  "properties": {
    "schema_version": {"const": 1},
    "implementation_version": {"const": "0.1.0-astara.1"},
    "upstream_baseline": {"const": "v0.8.0"},
    "upstream_commit": {"const": "1edcd54b43606d9079bb36650efe3f68707a79ea"},
    "feature_profile": {"const": "astara-knowledge"},
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "ui", "source", "tool", "readiness", "migration"],
      "properties": {
        "api": {"const": 1}, "ui": {"const": 1}, "source": {"const": 1},
        "tool": {"const": 1}, "readiness": {"const": 1}, "migration": {"const": 1}
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "web", "docreader"],
      "properties": {
        "api": {"const": "ghcr.io/youmucz/astara-knowledge-api:0.1.0-astara.1"},
        "web": {"const": "ghcr.io/youmucz/astara-knowledge-web:0.1.0-astara.1"},
        "docreader": {"const": "ghcr.io/youmucz/astara-knowledge-docreader:0.1.0-astara.1"}
      }
    }
  }
}
